#!/bin/bash
# Service control wrapper: standard systemd verbs + recreate.
set -e

# shellcheck source=/dev/null
[ -f /etc/default/mcp-terminal ] && . /etc/default/mcp-terminal

SERVICE="mcp-terminal-docker.service"
RECREATE_SERVICE="mcp-terminal-docker-recreate.service"
DOCKER_RUN="/usr/lib/mcp-terminal/docker-run.sh"

usage() {
  cat <<'EOF'
Usage: mcp-terminal-docker <command>

Commands:
  start      Start the service (systemctl start)
  stop       Stop the service (systemctl stop)
  restart    Restart container without recreating it (stop + start)
  recreate   Remove and recreate container (after config, certificate, bind-mount,
             or host_execution / sudoers changes)
  status     Show systemd and container status
  info       Show host user, port, paths, and image (mcp-terminal-info)

Examples:
  sudo mcp-terminal-docker recreate
  sudo systemctl start mcp-terminal-docker-recreate.service
EOF
}

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "[ERROR] Run as root: sudo mcp-terminal-docker $1" >&2
    exit 1
  fi
}

cmd="${1:-}"

case "$cmd" in
  start)
    require_root start
    systemctl start "$SERVICE"
    ;;
  stop)
    require_root stop
    systemctl stop "$SERVICE"
    ;;
  restart)
    require_root restart
    if [ -x "$DOCKER_RUN" ]; then
      "$DOCKER_RUN" restart
    else
      systemctl restart "$SERVICE"
    fi
    ;;
  recreate)
    require_root recreate
    if [ -x /usr/lib/mcp-terminal/ensure-host-permissions.sh ]; then
      /usr/lib/mcp-terminal/ensure-host-permissions.sh || exit 1
    fi
    if [ -x /usr/lib/mcp-terminal/sync-host-sudo.sh ] \
      && [ -f "${MCP_TERMINAL_CONFIG_DIR:-/etc/mcp-terminal}/${MCP_TERMINAL_CONFIG_FILE:-term_server.json}" ]; then
      /usr/lib/mcp-terminal/sync-host-sudo.sh \
        "${MCP_TERMINAL_CONFIG_DIR:-/etc/mcp-terminal}/${MCP_TERMINAL_CONFIG_FILE:-term_server.json}" \
        || exit 1
    fi
    if [ -x "$DOCKER_RUN" ]; then
      "$DOCKER_RUN" recreate
    else
      systemctl start "$RECREATE_SERVICE"
    fi
    ;;
  status)
    systemctl status "$SERVICE" --no-pager 2>/dev/null || true
    if command -v mcp-terminal-info >/dev/null 2>&1; then
      echo ""
      mcp-terminal-info
    fi
    ;;
  info)
    if command -v mcp-terminal-info >/dev/null 2>&1; then
      mcp-terminal-info
    else
      echo "[ERROR] mcp-terminal-info not installed" >&2
      exit 1
    fi
    ;;
  -h|--help|help|"")
    usage
    [ -z "$cmd" ] && exit 0
    ;;
  *)
    echo "[ERROR] Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
