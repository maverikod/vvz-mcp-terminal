#!/bin/bash
# Run config runtime preflight (schema + filesystem + docker) for mcp-terminal.
set -euo pipefail

# shellcheck source=/dev/null
[ -f /etc/default/mcp-terminal ] && . /etc/default/mcp-terminal

CONFIG_DIR="${MCP_TERMINAL_CONFIG_DIR:-/etc/mcp-terminal}"
CONFIG_FILE="${MCP_TERMINAL_CONFIG_FILE:-term_server.json}"
CONFIG_PATH="${CONFIG_DIR}/${CONFIG_FILE}"
CONTAINER="${MCP_TERMINAL_CONTAINER:-mcp-terminal}"

run_in_container() {
  docker exec "$CONTAINER" python3 -m mcp_terminal.config.config_cli validate "/etc/mcp-terminal/${CONFIG_FILE}"
}

run_on_host() {
  python3 -m mcp_terminal.config.config_cli validate "$CONFIG_PATH"
}

if [ ! -f "$CONFIG_PATH" ]; then
  echo "ERROR: config not found: ${CONFIG_PATH}" >&2
  exit 1
fi

if command -v docker >/dev/null 2>&1 \
  && docker ps --format '{{.Names}}' | grep -qx "$CONTAINER"; then
  echo "Running preflight inside container ${CONTAINER} ..."
  run_in_container
else
  echo "Container ${CONTAINER} not running; running host-side validate (docker checks may differ) ..."
  MCP_TERMINAL_SKIP_DOCKER_PREFLIGHT=1 run_on_host
fi
