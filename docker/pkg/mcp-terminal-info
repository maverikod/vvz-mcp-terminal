#!/bin/bash
# Display host-visible mcp-terminal user, port, image, and container status.
set -e

# shellcheck source=/dev/null
[ -f /etc/default/mcp-terminal ] && . /etc/default/mcp-terminal

MCP_TERMINAL_USER="${MCP_TERMINAL_USER:-mcp-terminal}"
MCP_TERMINAL_GROUP="${MCP_TERMINAL_GROUP:-mcp-terminal}"
MCP_TERMINAL_CONTAINER_USER="${MCP_TERMINAL_CONTAINER_USER:-root}"
MCP_TERMINAL_SSH_TARGET_USER="${MCP_TERMINAL_SSH_TARGET_USER:-mcp-terminal-host}"
PORT="${MCP_TERMINAL_PORT:-3011}"
CONTAINER="${MCP_TERMINAL_CONTAINER:-mcp-terminal}"
CONFIG_DIR="${MCP_TERMINAL_CONFIG_DIR:-/etc/mcp-terminal}"
CONFIG_FILE="${MCP_TERMINAL_CONFIG_FILE:-term_server.json}"
LOG_DIR="${MCP_TERMINAL_LOG_DIR:-/var/log/mcp-terminal}"
DATA_DIR="${MCP_TERMINAL_DATA_DIR:-/var/mcp-terminal}"
IMAGE_SPEC="/usr/lib/mcp-terminal/image-spec"
WATCH_BIND_SPECS="/usr/lib/mcp-terminal/watch_dir_bind_specs.py"
DEFAULT_KNOWN_HOSTS="${CONFIG_DIR}/ssh_known_hosts"

if [ -f "$IMAGE_SPEC" ]; then
  # shellcheck source=/dev/null
  . "$IMAGE_SPEC"
fi
IMAGE="${DOCKERHUB_REPO:-unknown}:${IMAGE_TAG:-unknown}"

uid=""
gid=""
if getent passwd "$MCP_TERMINAL_USER" >/dev/null 2>&1; then
  uid="$(id -u "$MCP_TERMINAL_USER")"
  gid="$(id -g "$MCP_TERMINAL_GROUP" 2>/dev/null || id -g "$MCP_TERMINAL_USER")"
fi

echo "MCP Terminal (mcp-terminal-docker)"
echo "  container user: ${MCP_TERMINAL_CONTAINER_USER} (service process inside Docker)"
echo "  package account: ${MCP_TERMINAL_USER}:${MCP_TERMINAL_GROUP} (uid=${uid:-n/a}, gid=${gid:-n/a})"
echo "  host scripts: root (docker-run, ensure-host-permissions, postinst)"

kh_path="$DEFAULT_KNOWN_HOSTS"
if [ -f "${CONFIG_DIR}/${CONFIG_FILE}" ] && command -v python3 >/dev/null 2>&1; then
  kh_path="$(python3 - <<'PY' "${CONFIG_DIR}/${CONFIG_FILE}" "$DEFAULT_KNOWN_HOSTS"
import json, sys
from pathlib import Path
cfg_path, default = sys.argv[1], sys.argv[2]
try:
    cfg = json.loads(Path(cfg_path).read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError):
    print(default)
    raise SystemExit(0)
he = (cfg.get("terminal") or {}).get("host_execution") or {}
ssh = he.get("ssh") or {}
print(ssh.get("known_hosts_path") or default)
PY
)"
fi
if [ -f "$kh_path" ] && [ -s "$kh_path" ]; then
  echo "  host ssh:    ${kh_path} (pinned host key present)"
elif [ -f "$kh_path" ]; then
  echo "  host ssh:    ${kh_path} (empty — pin host key before terminal_host_exec)"
else
  echo "  host ssh:    ${kh_path} missing (run mcp-terminal-docker recreate as root)"
fi
if getent passwd "$MCP_TERMINAL_SSH_TARGET_USER" >/dev/null 2>&1; then
  echo "  ssh target:  ${MCP_TERMINAL_SSH_TARGET_USER} ($(getent passwd "$MCP_TERMINAL_SSH_TARGET_USER" | cut -d: -f6))"
else
  echo "  ssh target:  ${MCP_TERMINAL_SSH_TARGET_USER} (missing — run ensure-ssh-target-user.sh)"
fi

watch_count=0
if [ -f "${CONFIG_DIR}/${CONFIG_FILE}" ] && [ -f "$WATCH_BIND_SPECS" ]; then
  watch_count="$(python3 "$WATCH_BIND_SPECS" "${CONFIG_DIR}/${CONFIG_FILE}" 2>/dev/null | wc -l | tr -d ' ')"
fi
echo "  watch_dirs:  auto-bind=${MCP_TERMINAL_AUTO_BIND_WATCH_DIRS:-1}, resolved mounts=${watch_count}"

echo "  host port:   ${PORT} -> container 3011"
echo "  config file: ${CONFIG_DIR}/${CONFIG_FILE}"
echo "  log dir:     ${LOG_DIR}"
echo "  data dir:    ${DATA_DIR}"
echo "  docker image: ${IMAGE}"

if command -v docker >/dev/null 2>&1; then
  if docker ps -a --format '{{.Names}}' | grep -qx "$CONTAINER"; then
    state="$(docker inspect "$CONTAINER" --format '{{.State.Status}}' 2>/dev/null || echo unknown)"
    published="$(docker port "$CONTAINER" 3011/tcp 2>/dev/null | head -1 || true)"
    run_user="$(docker inspect "$CONTAINER" --format '{{.Config.User}}' 2>/dev/null || true)"
    echo "  container:   ${CONTAINER} (${state}, Config.User=${run_user:-root})"
    if [ -n "$published" ]; then
      echo "  published:   ${published}"
    fi
  else
    echo "  container:   ${CONTAINER} (not created — sudo mcp-terminal-docker recreate)"
  fi
  echo ""
  echo "Preflight: mcp-terminal-preflight  (validate config inside container when running)"
else
  echo "  container:   docker CLI not available"
fi

if command -v systemctl >/dev/null 2>&1; then
  if systemctl is-active mcp-terminal-docker.service >/dev/null 2>&1; then
    echo "  systemd:     mcp-terminal-docker.service active"
  else
    echo "  systemd:     mcp-terminal-docker.service inactive"
  fi
fi
